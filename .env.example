# 서버 전용 PostgreSQL 연결. 실제 비밀값을 Git에 커밋하지 마세요.
# 애플리케이션/seed는 DATABASE_URL을 사용합니다. 기본 스키마 public을 사용합니다.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yogeollo"
# migration CLI 전용 직접 연결. 미설정 또는 빈 값이면 DATABASE_URL을 사용합니다.
# 연결 풀을 사용하는 배포 환경에서는 migration용 직접 주소를 설정하세요.
DIRECT_URL=""
# DB 통합 테스트 전용. 이름이 _test로 끝나는 별도 DB만 허용합니다.
# 테스트 실행 전에 명시적으로 환경변수로 전달하세요. 실제 서비스 DB를 사용하지 마세요.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yogeollo_test"
# 공개 URL에는 비밀정보를 넣지 마세요. 배포 전에 실제 서비스 주소로 설정합니다.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
